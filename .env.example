# Required in Vercel for Neon PostgreSQL runtime (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER/DATABASE?sslmode=require"

# Required for migrations and direct Prisma CLI operations (unpooled)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required: at least 32 random bytes
SESSION_SECRET="replace-with-a-long-random-secret"
